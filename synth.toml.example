# synth.toml — Synth 配置文件示例
# 复制为 synth.toml 并按照你的仓库结构修改。
# 运行: synth run

# ---------------------------------------------------------------------------
# 输出配置
# ---------------------------------------------------------------------------
[output]
language = "zh"        # zh（中文）| en（英文）
format   = "markdown"  # markdown | json | both
dir      = "synth-out" # 输出目录（自动创建）

# ---------------------------------------------------------------------------
# 缓存配置
# 使用 SHA256 内容哈希缓存 LLM 输出，节省 Token。
# 模块内容未变化时直接复用缓存，无需重新调用 LLM。
# ---------------------------------------------------------------------------
[cache]
dir     = ".synth-cache"
enabled = true

# ---------------------------------------------------------------------------
# LLM 配置
#
# provider 支持三种模式：
#   anthropic         — Anthropic Claude（默认，支持 prompt caching 降低成本）
#   openai            — OpenAI GPT 系列
#   openai-compatible — 任何兼容 OpenAI 接口的服务（GLM / DeepSeek / Qwen / Ollama 等）
#
# api_key 优先级：此处设置 > 对应的环境变量（建议用环境变量，避免提交到 git）
# ---------------------------------------------------------------------------

# ----- Anthropic Claude（默认）-----
[llm]
provider   = "anthropic"
model      = "claude-opus-4-6"
max_tokens = 2048
# api_key  = "sk-ant-..."   # 或 export ANTHROPIC_API_KEY=sk-ant-...

# ----- OpenAI -----
# [llm]
# provider   = "openai"
# model      = "gpt-4o"
# max_tokens = 2048
# api_key    = "sk-..."   # 或 export OPENAI_API_KEY=sk-...

# ----- 智谱 GLM -----
# [llm]
# provider   = "openai-compatible"
# model      = "glm-4-flash"
# base_url   = "https://open.bigmodel.cn/api/paas/v4/"
# api_key    = "your-zhipuai-key"

# ----- DeepSeek -----
# [llm]
# provider   = "openai-compatible"
# model      = "deepseek-chat"
# base_url   = "https://api.deepseek.com/v1"
# api_key    = "your-deepseek-key"

# ----- 阿里云百炼 Qwen -----
# [llm]
# provider   = "openai-compatible"
# model      = "qwen-turbo"
# base_url   = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# api_key    = "your-dashscope-key"

# ----- Ollama（本地）-----
# [llm]
# provider   = "openai-compatible"
# model      = "qwen2.5:7b"
# base_url   = "http://localhost:11434/v1"
# api_key    = "ollama"   # Ollama 不校验 key，随意填一个即可

# ---------------------------------------------------------------------------
# 仓库配置
# 每个仓库一个 [[repos]] 块。
#
# graph    — 指向该仓库 graphify-out/graph.json 的路径。
#            需先在该仓库目录运行 graphify 生成此文件。
#
# type     — microservice（独立部署的微服务）
#           | library（被其他服务引用的共享库）
#           | monorepo（单仓库多模块项目）
#
# packages — 该仓库对外暴露的包名 / 模块名列表。
#            用于跨仓库 import 关联检测：
#            当 Repo A 的代码 import 了 packages 中的某个名称，
#            Synth 会在 A 和该仓库之间创建一条跨仓库调用边。
# ---------------------------------------------------------------------------

# ----- 微服务示例 -----

[[repos]]
name     = "user-service"
graph    = "../user-service/graphify-out/graph.json"
type     = "microservice"
packages = ["@company/user-service"]

[[repos]]
name     = "order-service"
graph    = "../order-service/graphify-out/graph.json"
type     = "microservice"
packages = ["@company/order-service"]

[[repos]]
name     = "payment-service"
graph    = "../payment-service/graphify-out/graph.json"
type     = "microservice"
packages = ["@company/payment-service"]

# ----- 共享库示例 -----

[[repos]]
name     = "shared-utils"
graph    = "../shared-utils/graphify-out/graph.json"
type     = "library"
# 多个包名都指向同一仓库时，全部列出
packages = ["@company/shared-utils", "shared_utils", "shared-utils"]

# ----- Monorepo 示例（多包 / 多模块）-----
# monorepo 类型时，packages 列出各子包名称

[[repos]]
name     = "platform"
graph    = "../platform/graphify-out/graph.json"
type     = "monorepo"
packages = [
    "@platform/core",
    "@platform/auth",
    "@platform/db",
    "@platform/events",
]
